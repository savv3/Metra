msgstr "Käyttäjätilisi: %(organisation)s"

#: apps/setup/views.py:287
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"%(inviter)s has made you an account for %(organisation)s in Metra. Your "
"username is %(username)s.\n"
"\n"
"Choose your password here:\n"
"%(link)s\n"
"\n"
"The link works for a few days."
msgstr ""
"Hei %(name)s,\n"
"\n"
"%(inviter)s on luonut sinulle käyttäjätilin Metraan (%(organisation)s). "
"Käyttäjätunnuksesi on %(username)s.\n"
"\n"
"Valitse salasanasi täällä:\n"
"%(link)s\n"
"\n"
"Linkki toimii muutaman päivän."

