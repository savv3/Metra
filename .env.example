# Copy to .env and edit. Used by docker compose.
# To run several organisations on one server, see docs/multiple-organisations.md
# (docker/new-instance.sh writes this file for you).

# Compose project name: prefixes this install's containers and volumes. Each
# install on the same server needs its own. Defaults to the folder name.
# COMPOSE_PROJECT_NAME=metra

# Image the web and worker containers run. Give installs different tags to
# upgrade them one at a time. Released images are also published, tagged by
# version, for example ghcr.io/savv3/metra:0 (see docs/releasing.md).
# METRA_IMAGE=metra:latest

# Public domain Caddy serves (automatic HTTPS). Use "localhost" for local testing.
METRA_DOMAIN=localhost

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
METRA_SECRET_KEY=change-me

# Optional. Encrypts secrets saved in the app (plugins' API keys and
# passwords). Without it a key is derived from METRA_SECRET_KEY. Restoring a
# snapshot on another server needs the same value, or the saved secrets must
# be entered again.
# METRA_SETTINGS_KEY=

# Never enable in production.
METRA_DEBUG=false

# Staff (who can open Settings) must log in with two-factor (an authenticator
# app). Defaults to true, and to false when METRA_DEBUG=true. Only turn it off
# for trying the app out; staff then see a warning on every page.
# METRA_REQUIRE_MFA=true

# Comma-separated host names Django accepts.
METRA_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (with scheme) trusted for CSRF, e.g. https://register.example.com
METRA_CSRF_TRUSTED_ORIGINS=https://localhost

# Address used in links sent to members (letters, SMS, email). Defaults to
# https://METRA_DOMAIN.
# METRA_BASE_URL=https://register.example.com

# Days a member self-service link works when it is not tied to a reading
# round (round links work until the round closes).
METRA_SELF_SERVICE_LINK_DAYS=30

# Trust the visitor address in X-Forwarded-For. Docker Compose sets this for
# the web container, behind Caddy; leave it off when nothing sets the header.
# METRA_TRUST_X_FORWARDED_FOR=false

# Time zone for dates and scheduling.
METRA_TIME_ZONE=Europe/Helsinki

# Data directory (SQLite databases and media). Set to /data by the image.
# METRA_DATA_DIR=/data

# Run background tasks inline instead of via the worker (development only).
# METRA_HUEY_IMMEDIATE=false

# Backups (see INSTALL.md, "Backup and restore"). Snapshots of the database
# and uploads are kept in METRA_DATA_DIR/snapshots; set METRA_BACKUP_REMOTE_TYPE
# to also send each one, encrypted, off the server with rclone.
# Keep every automatic snapshot this many days, then the newest of each week
# and of each month this long. Snapshots taken by hand stay until deleted.
METRA_BACKUP_KEEP_DAYS=7
METRA_BACKUP_KEEP_WEEKS=4
METRA_BACKUP_KEEP_MONTHS=12
# Local time of the nightly snapshot (HH:MM).
METRA_BACKUP_TIME=02:30

# Remote: empty (local only), s3, sftp or ftps.
METRA_BACKUP_REMOTE_TYPE=
# Bucket and folder for S3 (e.g. my-bucket/register), or a folder on the server.
METRA_BACKUP_REMOTE_PATH=
# Encrypts file contents and names before upload. Store it somewhere safe as
# well: without it the remote backups cannot be restored.
METRA_BACKUP_ENCRYPTION_PASSWORD=

# S3 or S3-compatible storage.
METRA_BACKUP_S3_PROVIDER=Other
METRA_BACKUP_S3_ENDPOINT=
METRA_BACKUP_S3_REGION=
METRA_BACKUP_S3_ACCESS_KEY_ID=
METRA_BACKUP_S3_SECRET_ACCESS_KEY=

# SFTP or FTPS (explicit TLS).
METRA_BACKUP_HOST=
METRA_BACKUP_PORT=
METRA_BACKUP_USER=
METRA_BACKUP_PASSWORD=
# SFTP only: a private key file inside the container, instead of a password.
METRA_BACKUP_SFTP_KEY_FILE=

# Email is set by an admin under Settings > Email (or in the setup wizard).
# Leave these empty for that. A variable that is set wins over the page and
# shows there as locked; METRA_EMAIL_HOST or METRA_EMAIL_BACKEND (smtp,
# console or none) also fix how email is sent, as before the page existed.
# See INSTALL.md, "Email and SMS".
METRA_EMAIL_HOST=
METRA_EMAIL_PORT=
METRA_EMAIL_USER=
METRA_EMAIL_PASSWORD=
# STARTTLS (usually port 587), or SSL from the start (usually port 465).
METRA_EMAIL_USE_TLS=
METRA_EMAIL_USE_SSL=
METRA_EMAIL_FROM=
METRA_EMAIL_REPLY_TO=
# METRA_EMAIL_BACKEND=

# Mailgun (the bundled metra-email-mailgun add-on), usually set under
# Settings > Add-ons > Mailgun and chosen under Settings > Email. A value set
# here wins over the page. Region: eu (default) or us.
METRA_MAILGUN_DOMAIN=
METRA_MAILGUN_API_KEY=
METRA_MAILGUN_REGION=
METRA_MAILGUN_WEBHOOK_KEY=

# SMS through 46elks (the bundled metra-sms-46elks plugin, on by default).
# Setting the API user and password turns SMS on.
METRA_ELKS_API_USER=
METRA_ELKS_API_PASSWORD=
# Sender shown on the phone: up to 11 letters and digits, or a phone number.
METRA_SMS_SENDER=
# Country code added to numbers written without one (040 123 4567).
METRA_SMS_COUNTRY_CODE=358
# Let 46elks check messages without sending them or charging.
METRA_ELKS_DRY_RUN=false
# Provider name. auto (the default) picks the first configured provider, such
# as 46elks once its API user and password are set, or the console in
# development. Also: console, none, or a plugin provider's name.
# METRA_SMS_PROVIDER=auto

# Newsletters are sent this many emails at a time, with this many seconds
# between parts, to stay within the mail server's limits.
METRA_NEWSLETTER_BATCH_SIZE=50
METRA_NEWSLETTER_PAUSE_SECONDS=60

# Files attached to messages and newsletters (PDF, images, office documents):
# the largest single file and all files of one message together, in MB. SMS
# recipients get a link to the files instead, valid for
# METRA_SELF_SERVICE_LINK_DAYS days.
METRA_ATTACHMENT_FILE_MB=10
METRA_ATTACHMENT_TOTAL_MB=15

# Remind units missing a reading this many days before a round closes (at
# 10:00). Leave empty to send reminders only by hand.
METRA_READING_REMINDER_DAYS=

# Plugins (see docs/plugins.md). Packages to install into the image at build
# time (pip names, URLs or paths), separated by spaces; rebuild after a change.
METRA_PLUGIN_PACKAGES=
# Comma-separated plugin names to enable. Nothing loads unless it is listed,
# except the official plugins that come with Metra, which are on by default.
METRA_PLUGINS=
# Comma-separated official plugins to turn off (see docs/plugins.md).
METRA_PLUGINS_DISABLED=

# REST API (the api plugin, on with METRA_PLUGINS=api; see docs/api.md): the
# calls each API client may make, per second, minute, hour or day.
# METRA_API_RATE=120/min

# Webhooks plugin (docs/webhooks.md), when METRA_PLUGINS includes webhooks:
# how many days to keep the record of what was sent to each endpoint.
METRA_WEBHOOK_KEEP_DAYS=30
