#: plugins/sms-46elks/src/metra_sms_46elks/apps.py:11
msgid "Send Metra's SMS through 46elks, with delivery reports."
msgstr "Skickar Metras sms via 46elks, med leveransrapporter."

#: plugins/sms-46elks/src/metra_sms_46elks/apps.py:23
msgid "API username"
msgstr "API-användarnamn"

#: plugins/sms-46elks/src/metra_sms_46elks/apps.py:24
#: plugins/sms-46elks/src/metra_sms_46elks/apps.py:31
msgid "At 46elks, under Account."
msgstr "Hos 46elks, under Account."

#: plugins/sms-46elks/src/metra_sms_46elks/apps.py:29
msgid "API password"
msgstr "API-lösenord"

#: plugins/sms-46elks/src/metra_sms_46elks/apps.py:36
msgid "Sender"
msgstr "Avsändare"

#: plugins/sms-46elks/src/metra_sms_46elks/apps.py:38
msgid ""
"The name shown on the phone, up to 11 letters and digits (for example "
"Vatten), or a number you have at 46elks."
msgstr ""
"Namnet som visas i telefonen, högst 11 bokstäver och siffror (till exempel "
"Vatten), eller ett nummer du har hos 46elks."

#: plugins/sms-46elks/src/metra_sms_46elks/apps.py:45
msgid "Test mode"
msgstr "Testläge"

#: plugins/sms-46elks/src/metra_sms_46elks/apps.py:47
msgid "46elks checks messages without sending them or charging."
msgstr "46elks kontrollerar meddelandena utan att skicka dem eller ta betalt."
