msgstr "Maksu kirjattiin"

#: plugins/webhooks/src/metra_webhooks/forms.py:10
#: plugins/webhooks/src/metra_webhooks/templates/metra_webhooks/endpoint_list.html:18
msgid "Events"
msgstr "Tapahtumat"

#: plugins/webhooks/src/metra_webhooks/forms.py:13
msgid "The endpoint gets nothing until at least one event is ticked."
msgstr ""
"Vastaanottaja ei saa mitään, ennen kuin vähintään yksi tapahtuma on valittu."

#: plugins/webhooks/src/metra_webhooks/forms.py:17
msgid "Address"
msgstr "Osoite"

#: plugins/webhooks/src/metra_webhooks/forms.py:20
msgid "Where Metra sends the events. Must start with https://."
msgstr "Minne Metra lähettää tapahtumat. Osoitteen on alettava https://."

#: plugins/webhooks/src/metra_webhooks/forms.py:27
msgid "What the receiver is, for your own reference."
msgstr "Mikä vastaanottaja on, omaa käyttöäsi varten."

