#: plugins/webhooks/src/metra_webhooks/service.py:65
msgid "The address must start with https://."
msgstr "Osoitteen on alettava https://."

#: plugins/webhooks/src/metra_webhooks/service.py:67
msgid "The address must start with https:// or http://."
msgstr "Osoitteen on alettava https:// tai http://."

#: plugins/webhooks/src/metra_webhooks/service.py:70
msgid "The address must not contain a user name or password."
msgstr "Osoite ei saa sisältää käyttäjätunnusta tai salasanaa."

#: plugins/webhooks/src/metra_webhooks/service.py:90
#: plugins/webhooks/src/metra_webhooks/service.py:93
#, python-format
msgid "The address %(host)s could not be found."
msgstr "Osoitetta %(host)s ei löytynyt."

#: plugins/webhooks/src/metra_webhooks/service.py:98
#, python-format
msgid "%(host)s points to an internal address, which is not allowed."
msgstr "%(host)s osoittaa sisäiseen osoitteeseen, mikä ei ole sallittua."

#: plugins/webhooks/src/metra_webhooks/service.py:248
msgid "The endpoint is switched off."
msgstr "Vastaanottaja on poissa käytöstä."

#: plugins/webhooks/src/metra_webhooks/service.py:265
#, python-format
msgid "The receiver answered %(status)s."
msgstr "Vastaanottaja vastasi %(status)s."

