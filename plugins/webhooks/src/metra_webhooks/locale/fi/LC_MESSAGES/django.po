#: plugins/webhooks/src/metra_webhooks/templates/metra_webhooks/endpoint_list.html:3
#: plugins/webhooks/src/metra_webhooks/templates/metra_webhooks/endpoint_list.html:6
msgid "Webhooks"
msgstr "Webhookit"

#: plugins/webhooks/src/metra_webhooks/apps.py:29
msgid "Tell outside systems when something changes in Metra."
msgstr "Kerro ulkoisille järjestelmille, kun jokin muuttuu Metrassa."

#: plugins/webhooks/src/metra_webhooks/apps.py:35
msgid "A webhook could not be delivered"
msgstr "Webhookia ei voitu toimittaa"

#: plugins/webhooks/src/metra_webhooks/apps.py:37
#, python-format
msgid "A webhook to %(endpoint)s could not be delivered and was given up."
msgid_plural ""
"%(count)s webhooks to %(endpoint)s could not be delivered and were given up."
msgstr[0] ""
"Webhookia kohteeseen %(endpoint)s ei voitu toimittaa, ja siitä luovuttiin."
msgstr[1] ""
"%(count)s webhookia kohteeseen %(endpoint)s ei voitu toimittaa, ja niistä "
"luovuttiin."

#: plugins/webhooks/src/metra_webhooks/events.py:71
msgid "A unit was added or changed"
msgstr "Yksikkö lisättiin tai sitä muutettiin"

#: plugins/webhooks/src/metra_webhooks/events.py:72
msgid "A person was added or changed"
msgstr "Henkilö lisättiin tai häntä muutettiin"

#: plugins/webhooks/src/metra_webhooks/events.py:75
msgid "A reading was entered or corrected"
msgstr "Lukema syötettiin tai korjattiin"

#: plugins/webhooks/src/metra_webhooks/events.py:79
msgid "An invoice was issued"
msgstr "Lasku annettiin"

#: plugins/webhooks/src/metra_webhooks/events.py:82
