msgstr "Tähän vastaanottajaan ei ole vielä lähetetty mitään."

#: plugins/webhooks/src/metra_webhooks/templates/metra_webhooks/endpoint_confirm_delete.html:3
#: plugins/webhooks/src/metra_webhooks/templates/metra_webhooks/endpoint_confirm_delete.html:5
msgid "Delete endpoint"
msgstr "Poista vastaanottaja"

#: plugins/webhooks/src/metra_webhooks/templates/metra_webhooks/endpoint_confirm_delete.html:6
#, python-format
msgid "Delete %(name)s and its delivery history? Nothing more is sent to it."
msgstr ""
"Poistetaanko %(name)s ja sen toimitushistoria? Sinne ei lähetetä enää mitään."

#: plugins/webhooks/src/metra_webhooks/templates/metra_webhooks/endpoint_confirm_delete.html:10
#: plugins/webhooks/src/metra_webhooks/templates/metra_webhooks/endpoint_form.html:40
msgid "Delete"
msgstr "Poista"

#: plugins/webhooks/src/metra_webhooks/templates/metra_webhooks/endpoint_confirm_delete.html:11
#: plugins/webhooks/src/metra_webhooks/templates/metra_webhooks/endpoint_form.html:17
msgid "Cancel"
msgstr "Peruuta"

#: plugins/webhooks/src/metra_webhooks/templates/metra_webhooks/endpoint_form.html:3
#: plugins/webhooks/src/metra_webhooks/templates/metra_webhooks/endpoint_form.html:6
