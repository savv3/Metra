msgstr "Poista tositeluonnos"

#: templates/metra_bookkeeping/voucher_confirm_delete.html:6
#, python-format
msgid ""
"Delete the draft \"%(description)s\" and its receipts? Drafts have no "
"number, so this leaves no gap."
msgstr ""
"Poistetaanko luonnos \"%(description)s\" ja sen kuitit? Luonnoksilla ei ole "
"numeroa, joten numerointiin ei jää aukkoa."

