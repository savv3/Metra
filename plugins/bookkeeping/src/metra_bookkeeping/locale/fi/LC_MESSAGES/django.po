#: templates/metra_bookkeeping/voucher_detail.html:53
#: templates/metra_bookkeeping/voucher_form.html:26
msgid "VAT"
msgstr "ALV"

#: forms.py:147
msgid "The VAT the line is for, when VAT registered."
msgstr "ALV, jota rivi koskee, kun organisaatio on arvonlisäverovelvollinen."

#: forms.py:184
msgid "Choose a VAT rate from the list."
msgstr "Valitse ALV-kanta luettelosta."

#: forms.py:198
msgid "Add the voucher's lines."
msgstr "Lisää tositteen rivit."

