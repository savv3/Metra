#, python-format
msgid "A PDF or a photo of the receipt or bill, up to %(mb)s MB."
msgstr "PDF tai valokuva kuitista tai laskusta, enintään %(mb)s Mt."

#: forms.py:222
msgid "This kind of file cannot be a receipt."
msgstr "Tämän tyyppinen tiedosto ei kelpaa kuitiksi."

#: forms.py:225
#, python-format
msgid "The file is larger than %(limit)s."
msgstr "Tiedosto on suurempi kuin %(limit)s."

