#, python-format
msgid "Voucher %(number)s"
msgstr "Tosite %(number)s"

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:391
msgid "Vouchers are posted with post()."
msgstr "Tositteet kirjataan post()-metodilla."

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:420
#: plugins/bookkeeping/src/metra_bookkeeping/views.py:338
msgid "A posted voucher cannot change. Correct it with a reversing voucher."
msgstr "Kirjattua tositetta ei voi muuttaa. Oikaise se vastakirjauksella."

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:440
#, python-format
msgid "The date is outside the financial year %(year)s."
msgstr "Päivämäärä on tilikauden %(year)s ulkopuolella."

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:444
msgid "A voucher needs at least two lines."
msgstr "Tositteella on oltava vähintään kaksi riviä."

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:448
#, python-format
msgid "Debits (%(debit)s) and credits (%(credit)s) differ."
msgstr "Debet (%(debit)s) ja kredit (%(credit)s) eivät täsmää."

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:455
msgid "The amounts are zero."
msgstr "Summat ovat nolla."

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:459
