msgid "Micro-entity format"
msgstr "Mikroyrityksen muoto"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:323
msgid "Leaves out the breakdowns a micro entity need not show."
msgstr "Jättää pois erittelyt, joita mikroyrityksen ei tarvitse esittää."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:358
msgid "At"
msgstr "Päivänä"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:460
