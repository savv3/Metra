msgstr "Avoin"

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:75
msgid "Closed"
msgstr "Suljettu"

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:77
msgid "first day"
msgstr "ensimmäinen päivä"

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:78
