msgid "VAT"
msgstr "ALV"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:157
msgid "The VAT the line is for, when VAT registered."
msgstr "ALV, jota rivi koskee, kun organisaatio on arvonlisäverovelvollinen."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:194
msgid "Choose a VAT rate from the list."
msgstr "Valitse ALV-kanta luettelosta."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:208
msgid "Add the voucher's lines."
msgstr "Lisää tositteen rivit."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:223
msgid "Receipt"
msgstr "Kuitti"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:224
#, python-format
msgid "A PDF or a photo of the receipt or bill, up to %(mb)s MB."
msgstr "PDF tai valokuva kuitista tai laskusta, enintään %(mb)s Mt."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:232
msgid "This kind of file cannot be a receipt."
msgstr "Tämän tyyppinen tiedosto ei kelpaa kuitiksi."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:235
#, python-format
msgid "The file is larger than %(limit)s."
msgstr "Tiedosto on suurempi kuin %(limit)s."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:246
msgid "Date of the reversal"
msgstr "Vastakirjauksen päivämäärä"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:248
msgid "Reason"
msgstr "Syy"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:250
msgid "Why the voucher is reversed, for example a wrong account."
msgstr "Miksi tosite oikaistaan, esimerkiksi väärä tili."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:261
#: plugins/bookkeeping/src/metra_bookkeeping/models.py:574
msgid "There is no open financial year for that date."
msgstr "Tälle päivälle ei ole avointa tilikautta."

