msgid "The bank statement balance of %(account)s is not given."
msgstr "Tilin %(account)s tiliotteen saldoa ei ole annettu."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:229
#, python-format
msgid "%(account)s differs from the bank statement by %(amount)s."
msgstr "%(account)s poikkeaa tiliotteesta %(amount)s."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:235
#, python-format
