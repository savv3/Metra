msgstr "Kanta (%)"

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:1305
msgid "To pay (to get back if negative)"
msgstr "Maksettavaa (palautettavaa, jos negatiivinen)"

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:85
msgid "Choose a day in the financial year."
msgstr "Valitse päivä tilikaudelta."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:87
msgid "The books are already locked up to that day."
msgstr "Kirjanpito on jo lukittu kyseiseen päivään asti."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:92
#, python-format
msgid ""
"%(count)s draft voucher is dated in the period. Post or delete it first."
msgid_plural ""
"%(count)s draft vouchers are dated in the period. Post or delete them first."
msgstr[0] ""
"%(count)s tositeluonnos on päivätty jaksolle. Kirjaa tai poista se ensin."
msgstr[1] ""
"%(count)s tositeluonnosta on päivätty jaksolle. Kirjaa tai poista ne ensin."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:158
#, python-format
msgid "Close the financial year %(year)s first."
msgstr "Sulje ensin tilikausi %(year)s."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:160
msgid "The year has not ended yet."
msgstr "Tilikausi ei ole vielä päättynyt."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:165
#, python-format
msgid "%(count)s draft voucher is waiting. Post or delete it."
msgid_plural "%(count)s draft vouchers are waiting. Post or delete them."
msgstr[0] "%(count)s tositeluonnos odottaa. Kirjaa tai poista se."
msgstr[1] "%(count)s tositeluonnosta odottaa. Kirjaa tai poista ne."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:174
#, python-format
msgid ""
"%(count)s record from invoicing dated in the year is waiting to be booked."
msgid_plural ""
"%(count)s records from invoicing dated in the year are waiting to be booked."
msgstr[0] ""
"%(count)s laskutuksen kirjaus, joka on päivätty tilikaudelle, odottaa "
"kirjaamista."
msgstr[1] ""
"%(count)s laskutuksen kirjausta, jotka on päivätty tilikaudelle, odottaa "
"kirjaamista."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:187
#, python-format
msgid "These accounts fall on no line of the statements: %(accounts)s."
msgstr "Nämä tilit eivät osu mihinkään laskelmien riviin: %(accounts)s."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:191
msgid "The balance sheet does not balance."
msgstr "Tase ei täsmää."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:195
#, python-format
msgid ""
"The next year already has opening balances (voucher %(number)s). Reverse "
"them, so the closing can carry the balances over."
msgstr ""
"Seuraavalla tilikaudella on jo avaavat saldot (tosite %(number)s). Tee "
"niistä vastakirjaus, jotta sulkeminen voi siirtää saldot."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:210
msgid "The depreciation by plan is not booked."
msgstr "Suunnitelman mukaisia poistoja ei ole kirjattu."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:216
#, python-format
msgid ""
"Invoiced income across the year end is not fully accrued or deferred (income"
" still to move: %(amount)s). Make the accrual voucher."
msgstr ""
"Tilikauden vaihteen yli laskutettuja tuottoja ei ole jaksotettu kokonaan "
"(siirtämättä: %(amount)s). Tee jaksotustosite."

#: plugins/bookkeeping/src/metra_bookkeeping/yearend.py:224
