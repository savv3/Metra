msgstr "Tosite %(number)s kirjattiin."

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:757
msgid "The draft voucher was deleted."
msgstr "Tositeluonnos poistettiin."

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:781
#, python-format
msgid ""
"Voucher %(number)s reverses it. Enter the right entry as a new voucher."
msgstr "Tosite %(number)s oikaisee sen. Anna oikea kirjaus uutena tositteena."

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:814
msgid "The receipt was added."
msgstr "Kuitti lisättiin."

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:849
msgid "The receipt was removed."
msgstr "Kuitti poistettiin."

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:866
msgid "The posting settings were saved."
msgstr "Kirjausasetukset tallennettiin."

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:896
#, python-format
msgid "Added the accounts %(accounts)s."
msgstr "Lisättiin tilit %(accounts)s."

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:909
#: plugins/bookkeeping/src/metra_bookkeeping/views.py:924
msgid "The VAT registration was saved."
msgstr "ALV-rekisteröinti tallennettiin."

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:938
msgid "The VAT registration was removed."
msgstr "ALV-rekisteröinti poistettiin."

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:952
