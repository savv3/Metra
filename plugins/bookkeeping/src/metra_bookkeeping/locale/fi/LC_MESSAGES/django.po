msgstr "Valitse päivä avoimelta tilikaudelta."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:497
#, python-format
msgid "Choose these accounts before posting starts: %(names)s."
msgstr "Valitse nämä tilit ennen kirjaamisen alkua: %(names)s."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:504
msgid ""
"Sales VAT, purchase VAT and the VAT settlement need accounts of their own."
msgstr "Myynnin ALV, ostojen ALV ja ALV-tilitys tarvitsevat omat tilinsä."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:507
msgid "Receivables and the bank need accounts of their own."
msgstr "Myyntisaamiset ja pankki tarvitsevat omat tilinsä."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:559
msgid "Default sales account"
msgstr "Myynnin oletustili"

