msgstr "Kirjanpito on lukittu päivään %(day)s asti."

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:216
msgid "Choose the last day to lock."
msgstr "Valitse viimeinen lukittava päivä."

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:241
#, python-format
msgid ""
"The financial year %(year)s is closed, and %(next)s has its opening "
"balances."
msgstr ""
"Tilikausi %(year)s on suljettu, ja tilikaudella %(next)s on avaavat saldot."

#: plugins/bookkeeping/src/metra_bookkeeping/views.py:289
