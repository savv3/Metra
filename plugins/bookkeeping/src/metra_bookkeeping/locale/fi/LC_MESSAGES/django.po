msgstr "tilikaudet"

#: models.py:139
msgid "The year must end after it starts."
msgstr "Tilikauden on päätyttävä sen alkamisen jälkeen."

#: models.py:145
#, python-format
msgid "Say why the year is not %(usual)s months."
msgstr "Kerro, miksi tilikausi ei ole %(usual)s kuukautta."

#: models.py:153
#, python-format
msgid ""
"A financial year is %(usual)s months; a first or changed one %(min)s to "
"%(max)s."
msgstr ""
"Tilikausi on %(usual)s kuukautta; ensimmäinen tai muutettu tilikausi "
"%(min)s–%(max)s kuukautta."

#: models.py:160
msgid "The year overlaps another financial year."
msgstr "Tilikausi menee päällekkäin toisen tilikauden kanssa."

#: models.py:165
#, python-format
msgid "The year must start the day after the previous one ends (%(day)s)."
msgstr ""
"Tilikauden on alettava edellisen päättymistä seuraavana päivänä (%(day)s)."

#: models.py:172
msgid "The year must end the day before the next one starts."
msgstr "Tilikauden on päätyttävä päivää ennen seuraavan alkamista."

#: models.py:175
msgid "Some of the year's vouchers would fall outside it."
msgstr "Osa tilikauden tositteista jäisi sen ulkopuolelle."

