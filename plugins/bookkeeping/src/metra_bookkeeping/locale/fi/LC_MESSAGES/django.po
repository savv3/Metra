#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/year_detail.html:6
#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/year_list.html:13
msgid "Financial year"
msgstr "Tilikausi"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:284
#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:363
#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:388
#: plugins/bookkeeping/src/metra_bookkeeping/views.py:1297
msgid "From"
msgstr "Alkaen"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:285
#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:364
#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:389
#: plugins/bookkeeping/src/metra_bookkeeping/views.py:1297
msgid "To"
msgstr "Asti"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:311
msgid "English (a translation, not for filing)"
msgstr "Englanti (käännös, ei toimitettavaksi viranomaiselle)"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:327
#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/year_notes.html:16
msgid "Language"
msgstr "Kieli"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:329
msgid "Without the previous year"
msgstr "Ilman edellistä vuotta"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:331
msgid "The previous financial year is shown beside it when it exists."
msgstr "Edellinen tilikausi näytetään vieressä, kun se on olemassa."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:334
msgid "Micro-entity format"
msgstr "Mikroyrityksen muoto"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:336
msgid "Leaves out the breakdowns a micro entity need not show."
msgstr "Jättää pois erittelyt, joita mikroyrityksen ei tarvitse esittää."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:371
msgid "At"
msgstr "Päivänä"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:473
msgid "Sales invoices"
msgstr "Myyntilaskut"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:474
msgid "Payments"
msgstr "Suoritukset"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:484
#, python-format
msgid "New series: %(code)s %(name)s"
msgstr "Uusi sarja: %(code)s %(name)s"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:497
msgid "Choose a day in an open financial year."
msgstr "Valitse päivä avoimelta tilikaudelta."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:510
#, python-format
msgid "Choose these accounts before posting starts: %(names)s."
msgstr "Valitse nämä tilit ennen kirjaamisen alkua: %(names)s."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:517
msgid ""
"Sales VAT, purchase VAT and the VAT settlement need accounts of their own."
msgstr "Myynnin ALV, ostojen ALV ja ALV-tilitys tarvitsevat omat tilinsä."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:520
msgid "Receivables and the bank need accounts of their own."
msgstr "Myyntisaamiset ja pankki tarvitsevat omat tilinsä."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:572
msgid "Default sales account"
msgstr "Myynnin oletustili"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:614
msgid "Lock the books up to"
msgstr "Lukitse kirjanpito päivään asti"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:630
msgid "Carry the result to"
msgstr "Siirrä tulos tilille"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:632
msgid "The result of earlier years, in the next year's opening balances."
msgstr "Aiempien vuosien tulos seuraavan vuoden avaavissa saldoissa."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:635
msgid "I understand that a closed year can never be changed or opened again."
msgstr ""
"Ymmärrän, että suljettua tilikautta ei voi koskaan muuttaa eikä avata "
"uudelleen."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:665
msgid "Statement"
msgstr "Tiliote"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:669
#: plugins/bookkeeping/src/metra_bookkeeping/models.py:1383
msgid "For example: statement 12/2026."
msgstr "Esimerkiksi: tiliote 12/2026."

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:700
msgid "Who signs the financial statements"
msgstr "Kuka allekirjoittaa tilinpäätöksen"

#: plugins/bookkeeping/src/metra_bookkeeping/forms.py:704
#: plugins/bookkeeping/src/metra_bookkeeping/models.py:118
