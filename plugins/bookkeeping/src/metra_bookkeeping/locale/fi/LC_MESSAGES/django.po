#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/account_list.html:39
msgid ""
"Vouchers are numbered without gaps within each series and financial year."
msgstr ""
"Tositteet numeroidaan ilman aukkoja kunkin sarjan ja tilikauden sisällä."

#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/account_list.html:45
#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/series_form.html:3
#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/series_form.html:5
