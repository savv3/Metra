#, python-format
msgid ""
"A financial year is %(usual)s months; a first or changed one %(min)s to "
"%(max)s."
msgstr ""
"En räkenskapsperiod är %(usual)s månader; en första eller ändrad period "
"%(min)s till %(max)s."

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:191
msgid "The year overlaps another financial year."
msgstr "Perioden överlappar en annan räkenskapsperiod."

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:196
#, python-format
msgid "The year must start the day after the previous one ends (%(day)s)."
msgstr "Perioden måste börja dagen efter att den föregående slutar (%(day)s)."

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:203
msgid "The year must end the day before the next one starts."
msgstr "Perioden måste sluta dagen före att nästa börjar."

#: plugins/bookkeeping/src/metra_bookkeeping/models.py:206
msgid "Some of the year's vouchers would fall outside it."
msgstr "Några av periodens verifikat skulle hamna utanför den."

