msgid_plural ""
"%(count)s invoices, payments and reminder fees have no voucher yet:"
msgstr[0] ""
"%(count)s faktura, betalning eller påminnelseavgift saknar verifikat ännu:"
msgstr[1] ""
"%(count)s fakturor, betalningar och påminnelseavgifter saknar verifikat ännu:"

#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/index.html:54
msgid "Post them now"
msgstr "Bokför dem nu"

#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/index.html:58
msgid "Set up the bookkeeping of invoices"
msgstr "Ställ in bokföringen av fakturor"

#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/index.html:58
msgid "to book invoices, payments and reminder fees without typing."
msgstr ""
"för att bokföra fakturor, betalningar och påminnelseavgifter utan att skriva "
"in dem."

