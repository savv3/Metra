#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/voucher_detail.html:40
msgid ""
"Made by Metra from the invoice, which is the evidence for this voucher."
msgstr "Gjort av Metra utifrån fakturan, som är underlag för verifikatet."

#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/voucher_detail.html:42
