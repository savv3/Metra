#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/account_list.html:39
msgid ""
"Vouchers are numbered without gaps within each series and financial year."
msgstr ""
"Verifikaten numreras utan luckor inom varje serie och räkenskapsperiod."

#: plugins/bookkeeping/src/metra_bookkeeping/templates/metra_bookkeeping/account_list.html:45
