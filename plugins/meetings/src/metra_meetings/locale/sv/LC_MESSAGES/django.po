msgid "Nobody who was invited can be reached any more."
msgstr "Ingen av de kallade kan längre nås."

#: plugins/meetings/src/metra_meetings/views.py:413
msgid "The reminder is being sent to everyone invited."
msgstr "Påminnelsen skickas till alla kallade."

#: plugins/meetings/src/metra_meetings/views.py:428
