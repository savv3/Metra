#: templates/metra_meetings/template_confirm_delete.html:3
#: templates/metra_meetings/template_confirm_delete.html:5
msgid "Delete agenda template"
msgstr "Ta bort mall för föredragningslista"

#: templates/metra_meetings/template_confirm_delete.html:6
#, python-format
msgid ""
"Delete the agenda template %(name)s? Meetings that started from it keep their"
" agenda."
msgstr ""
"Ta bort mallen för föredragningslista %(name)s? Möten som har utgått från den"
" behåller sin föredragningslista."

#: templates/metra_meetings/template_form.html:3
#: templates/metra_meetings/template_form.html:6
msgid "Edit agenda template"
msgstr "Redigera mall för föredragningslista"

#: templates/metra_meetings/template_form.html:3
#: templates/metra_meetings/template_form.html:6
msgid "New agenda template"
msgstr "Ny mall för föredragningslista"

#: templates/metra_meetings/template_list.html:8
msgid "New template"
msgstr "Ny mall"

#: templates/metra_meetings/template_list.html:12
msgid ""
"The usual agenda of each kind of meeting. A new meeting starts with the items"
" of the template for its kind, or of the one chosen, and you change them "
"there as needed. Changing a template does not change meetings already added."
msgstr ""
"Den vanliga föredragningslistan för varje slags möte. Ett nytt möte börjar "
"med ärendena i mallen för dess typ, eller i den mall som du väljer, och där "
"ändrar du dem vid behov. Om du ändrar en mall ändras inte möten som redan är "
"tillagda."

#: templates/metra_meetings/template_list.html:21
msgid "Template"
msgstr "Mall"

#: templates/metra_meetings/template_list.html:22
msgid "For"
msgstr "För"

#: templates/metra_meetings/template_list.html:23
msgid "Items"
msgstr "Ärenden"

#: templates/metra_meetings/template_list.html:30
msgid "Chosen by hand"
msgstr "Väljs för hand"

#: templates/metra_meetings/template_list.html:32
#, python-format
msgid "Delete<span class=\"visually-hidden\"> %(name)s</span>"
msgstr "Ta bort<span class=\"visually-hidden\"> %(name)s</span>"

#: templates/metra_meetings/template_list.html:39
msgid "No agenda templates yet."
msgstr "Inga mallar för föredragningslistor ännu."

#: views.py:47
msgid "The minutes changed, so the checkers' approvals so far were removed."
msgstr "Protokollet ändrades, så justerarnas godkännanden hittills togs bort."

#: views.py:55 views.py:353
msgid "PDFs cannot be made on this server (WeasyPrint is missing)."
msgstr "Pdf-filer kan inte skapas på den här servern (WeasyPrint saknas)."

#: views.py:99
#, python-format
msgid ""
"The meeting was added with the agenda from %(template)s. Check the items."
msgstr ""
"Mötet lades till med föredragningslistan från %(template)s. Kontrollera "
"ärendena."

#: views.py:103
msgid "The meeting was added. Now add the agenda."
msgstr "Mötet lades till. Lägg nu till föredragningslistan."

#: views.py:132
msgid "The meeting was saved."
msgstr "Mötet sparades."

#: views.py:143
msgid "The meeting was deleted."
msgstr "Mötet togs bort."

#: views.py:164
#, python-format
msgid "The meeting is now: %(status)s."
msgstr "Mötet är nu: %(status)s."

#: views.py:183
msgid "The item was added to the agenda."
msgstr "Ärendet lades till på föredragningslistan."

#: views.py:203
msgid "The item was saved."
msgstr "Ärendet sparades."

#: views.py:219
msgid "The item was removed from the agenda."
msgstr "Ärendet togs bort från föredragningslistan."

#: views.py:234
msgid "The minutes were saved."
msgstr "Protokollet sparades."

#: views.py:287
#, python-format
msgid "%(name)s was added as present."
msgstr "%(name)s antecknades som närvarande."

#: views.py:304
msgid "The attendance was saved."
msgstr "Närvaron sparades."

#: views.py:322
#, python-format
msgid "%(name)s was removed from the list."
msgstr "%(name)s togs bort från listan."

#: views.py:370
msgid ""
"The notice is ready with the agenda attached. Choose who gets it, check and "
"send. Then mark the meeting as called."
msgstr ""
"Kallelsen är klar med föredragningslistan bifogad. Välj vem som får den, "
"kontrollera och skicka. Markera sedan mötet som kallat."

#: views.py:392
msgid "The minutes are approved by every checker and can no longer be changed."
msgstr "Protokollet är justerat av alla justerare och kan inte längre ändras."

#: views.py:396
msgid "Thank you. The minutes are approved when every checker has approved."
msgstr "Tack. Protokollet är justerat när alla justerare har justerat det."

#: views.py:432
msgid "The agenda template was saved."
msgstr "Mallen för föredragningslistan sparades."

#: views.py:447
msgid "The agenda template was deleted."
msgstr "Mallen för föredragningslistan togs bort."
