msgstr "Kokouksen tila on nyt: %(status)s."

#: plugins/meetings/src/metra_meetings/views.py:200
msgid "The item was added to the agenda."
msgstr "Asia lisättiin esityslistalle."

#: plugins/meetings/src/metra_meetings/views.py:220
msgid "The item was saved."
msgstr "Asia tallennettiin."

#: plugins/meetings/src/metra_meetings/views.py:236
msgid "The item was removed from the agenda."
msgstr "Asia poistettiin esityslistalta."

#: plugins/meetings/src/metra_meetings/views.py:251
msgid "The minutes were saved."
msgstr "Pöytäkirja tallennettiin."

#: plugins/meetings/src/metra_meetings/views.py:304
#, python-format
msgid "%(name)s was added as present."
msgstr "%(name)s merkittiin läsnä olevaksi."

#: plugins/meetings/src/metra_meetings/views.py:321
msgid "The attendance was saved."
msgstr "Läsnäolo tallennettiin."

#: plugins/meetings/src/metra_meetings/views.py:339
#, python-format
msgid "%(name)s was removed from the list."
msgstr "%(name)s poistettiin listalta."

#: plugins/meetings/src/metra_meetings/views.py:379
msgid ""
"The invitation is ready with the agenda and a calendar file attached. Choose "
"who gets it, check and send. The meeting is then marked as called."
msgstr ""
"Kokouskutsu on valmis, ja esityslista ja kalenteritiedosto ovat liitteinä. "
"Valitse vastaanottajat, tarkista ja lähetä. Kokous merkitään sen jälkeen "
"kutsutuksi."

#: plugins/meetings/src/metra_meetings/views.py:388
msgid "No invitations have been sent for this meeting yet."
msgstr "Tästä kokouksesta ei ole vielä lähetetty kokouskutsuja."

#: plugins/meetings/src/metra_meetings/views.py:396
msgid "Nobody who was invited can be reached any more."
msgstr "Ketään kutsutuista ei enää tavoiteta."

#: plugins/meetings/src/metra_meetings/views.py:413
msgid "The reminder is being sent to everyone invited."
msgstr "Muistutus lähetetään kaikille kutsutuille."

#: plugins/meetings/src/metra_meetings/views.py:428
msgid "The updated invitation is being sent to everyone invited."
msgstr "Päivitetty kokouskutsu lähetetään kaikille kutsutuille."

#: plugins/meetings/src/metra_meetings/views.py:447
msgid "The minutes are approved by every checker and can no longer be changed."
msgstr ""
"Kaikki tarkastajat ovat hyväksyneet pöytäkirjan, eikä sitä voi enää muuttaa."

#: plugins/meetings/src/metra_meetings/views.py:451
msgid "Thank you. The minutes are approved when every checker has approved."
msgstr ""
"Kiitos. Pöytäkirja on tarkastettu, kun kaikki tarkastajat ovat hyväksyneet "
"sen."

#: plugins/meetings/src/metra_meetings/views.py:487
msgid "The agenda template was saved."
msgstr "Esityslistapohja tallennettiin."

#: plugins/meetings/src/metra_meetings/views.py:502
msgid "The agenda template was deleted."
msgstr "Esityslistapohja poistettiin."

#~ msgid "Send the notice"
#~ msgstr "Lähetä kokouskutsu"
