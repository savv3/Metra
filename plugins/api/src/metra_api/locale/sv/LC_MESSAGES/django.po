#: apps.py:22
msgid "Tokens for other systems that read or change the register."
msgstr "Tokens för andra system som läser eller ändrar registret."

#: auth.py:28
msgid "Give the token after Bearer, without spaces."
msgstr "Ange tokenen efter Bearer, utan mellanslag."

#: auth.py:32 auth.py:41
msgid "The token is not valid."
msgstr "Tokenen är inte giltig."

#: auth.py:43
msgid "The token has been revoked or has expired."
msgstr "Tokenen har återkallats eller gått ut."

#: forms.py:33
msgid "Expires after"
msgstr "Gäller till och med"

#: forms.py:36
msgid "Optional. The token stops working when this day is over."
msgstr "Valfritt. Tokenen slutar fungera när dagen är slut."

#: forms.py:45
msgid ""
"The client may do what a user with this role may. Choose the narrowest role "
"that does the job."
msgstr "Klienten får göra det som en användare med den här rollen får göra. Välj den snävaste roll som räcker."
"Klienten får göra det som en användare med den här rollen får göra. Välj den "
"snävaste roll som räcker."

#: forms.py:57
msgid "Choose today or a later day."
msgstr "Välj i dag eller en senare dag."

