#: plugins/email-mailgun/src/metra_email_mailgun/apps.py:13
msgid "Send Metra's email through Mailgun, with delivery and bounce reports."
msgstr ""
"Lähettää Metran sähköpostit Mailgunin kautta toimitus- ja palautusraporttien "
"kanssa."

#: plugins/email-mailgun/src/metra_email_mailgun/apps.py:25
msgid "Sending domain"
msgstr "Lähetysverkkotunnus"

#: plugins/email-mailgun/src/metra_email_mailgun/apps.py:26
msgid "The domain you added at Mailgun, for example mg.example.fi."
msgstr "Mailgunissa lisäämäsi verkkotunnus, esimerkiksi mg.example.fi."

#: plugins/email-mailgun/src/metra_email_mailgun/apps.py:31
msgid "API key"
msgstr "API-avain"

#: plugins/email-mailgun/src/metra_email_mailgun/apps.py:33
msgid "A sending API key for the domain, from Mailgun."
msgstr "Verkkotunnuksen lähetys-API-avain Mailgunista."

#: plugins/email-mailgun/src/metra_email_mailgun/apps.py:38
msgid "Region"
msgstr "Alue"

#: plugins/email-mailgun/src/metra_email_mailgun/apps.py:40
msgid "EU (api.eu.mailgun.net)"
msgstr "EU (api.eu.mailgun.net)"

#: plugins/email-mailgun/src/metra_email_mailgun/apps.py:40
msgid "US (api.mailgun.net)"
msgstr "Yhdysvallat (api.mailgun.net)"

#: plugins/email-mailgun/src/metra_email_mailgun/apps.py:43
msgid ""
"Where your Mailgun account keeps its data. Choose EU unless it was made in "
"the US."
msgstr ""
"Missä Mailgun-tilisi säilyttää tietonsa. Valitse EU, ellei tiliä luotu "
"Yhdysvalloissa."

#: plugins/email-mailgun/src/metra_email_mailgun/apps.py:49
msgid "Webhook signing key"
msgstr "Webhookien allekirjoitusavain"

#: plugins/email-mailgun/src/metra_email_mailgun/apps.py:53
#, python-brace-format
msgid ""
"From Mailgun's Webhooks page. There, add {url} for delivered messages, "
"permanent failures and spam complaints."
msgstr ""
"Mailgunin Webhooks-sivulta. Lisää siellä {url} toimitetuille viesteille, "
"pysyville virheille ja roskapostivalituksille."
